{
  "name": "green-alert",
  "version": "2.0.0",
  "private": true,
  "description": "Green Alert 2.0 — monorepo NestJS",
  "engines": {
    "node": ">=22 <25"
  },
  "workspaces": [
    "apps/frontend"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:backend": "node scripts/build.mjs --backend",
    "build:frontend": "npm run build --workspace @green-alert/frontend",
    "start": "node dist/apps/api-gateway/main.js",
    "start:dev": "nest start api-gateway --watch",
    "lint": "eslint \"{apps,libs,test}/**/*.ts\"",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json}\" \"libs/**/*.ts\" \"test/**/*.ts\" \"*.json\" \"*.yml\"",
    "test": "jest --runInBand",
    "test:integration": "jest --config test/jest-integration.json --runInBand",
    "infra:up": "docker compose up --build -d",
    "infra:down": "docker compose down",
    "infra:config": "docker compose config --quiet"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/jwt": "^11.0.0",
    "mongoose": "^8.19.0",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "bcrypt": "^6.0.0",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.0",
    "@types/amqplib": "^0.10.7",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.36.0",
    "@eslint/js": "^9.36.0",
    "typescript-eslint": "^8.44.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.4",
    "ts-loader": "^9.5.4",
    "supertest": "^7.1.4"
  }
}
