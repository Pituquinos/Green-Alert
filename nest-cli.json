{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/api-gateway",
  "sourceRoot": "apps/api-gateway/src",
  "compilerOptions": {
    "webpack": true,
    "deleteOutDir": false,
    "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
  },
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
      }
    },
    "auth-service": {
      "type": "application",
      "root": "apps/auth-service",
      "entryFile": "main",
      "sourceRoot": "apps/auth-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth-service/tsconfig.app.json"
      }
    },
    "users-service": {
      "type": "application",
      "root": "apps/users-service",
      "entryFile": "main",
      "sourceRoot": "apps/users-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/users-service/tsconfig.app.json"
      }
    },
    "reports-service": {
      "type": "application",
      "root": "apps/reports-service",
      "entryFile": "main",
      "sourceRoot": "apps/reports-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/reports-service/tsconfig.app.json"
      }
    },
    "geo-service": {
      "type": "application",
      "root": "apps/geo-service",
      "entryFile": "main",
      "sourceRoot": "apps/geo-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/geo-service/tsconfig.app.json"
      }
    },
    "evidence-service": {
      "type": "application",
      "root": "apps/evidence-service",
      "entryFile": "main",
      "sourceRoot": "apps/evidence-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/evidence-service/tsconfig.app.json"
      }
    },
    "notifications-service": {
      "type": "application",
      "root": "apps/notifications-service",
      "entryFile": "main",
      "sourceRoot": "apps/notifications-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notifications-service/tsconfig.app.json"
      }
    },
    "analytics-service": {
      "type": "application",
      "root": "apps/analytics-service",
      "entryFile": "main",
      "sourceRoot": "apps/analytics-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/analytics-service/tsconfig.app.json"
      }
    }
  }
}
