# Local defaults. Copy to .env and run: node scripts/init-env.mjs
NODE_ENV=development
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
CADDY_SITE=http://localhost
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
USERS_SERVICE_PORT=3002
REPORTS_SERVICE_PORT=3003
GEO_SERVICE_PORT=3004
EVIDENCE_SERVICE_PORT=3005
NOTIFICATIONS_SERVICE_PORT=3006
ANALYTICS_SERVICE_PORT=3007
MONGO_ROOT_PASSWORD=CHANGE_ME
RABBITMQ_USER=greenalert
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_URI=amqp://greenalert:CHANGE_ME@rabbitmq:5672
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
MONGO_AUTH_PASSWORD=CHANGE_ME
MONGO_AUTH_URI=mongodb://greenalert_auth:CHANGE_ME@mongodb:27017/greenalert_auth?authSource=greenalert_auth
MONGO_USERS_PASSWORD=CHANGE_ME
MONGO_USERS_URI=mongodb://greenalert_users:CHANGE_ME@mongodb:27017/greenalert_users?authSource=greenalert_users
MONGO_REPORTS_PASSWORD=CHANGE_ME
MONGO_REPORTS_URI=mongodb://greenalert_reports:CHANGE_ME@mongodb:27017/greenalert_reports?authSource=greenalert_reports
MONGO_GEO_PASSWORD=CHANGE_ME
MONGO_GEO_URI=mongodb://greenalert_geo:CHANGE_ME@mongodb:27017/greenalert_geo?authSource=greenalert_geo
MONGO_EVIDENCE_PASSWORD=CHANGE_ME
MONGO_EVIDENCE_URI=mongodb://greenalert_evidence:CHANGE_ME@mongodb:27017/greenalert_evidence?authSource=greenalert_evidence
MONGO_NOTIFICATIONS_PASSWORD=CHANGE_ME
MONGO_NOTIFICATIONS_URI=mongodb://greenalert_notifications:CHANGE_ME@mongodb:27017/greenalert_notifications?authSource=greenalert_notifications
MONGO_ANALYTICS_PASSWORD=CHANGE_ME
MONGO_ANALYTICS_URI=mongodb://greenalert_analytics:CHANGE_ME@mongodb:27017/greenalert_analytics?authSource=greenalert_analytics
